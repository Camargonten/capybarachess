# Generate locally with: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-secret

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Keep false for local http://127.0.0.1; use true on an HTTPS host.
COOKIE_SECURE=false
APP_DEBUG=false
PORT=5000

# RECOMMENDED in production (Render free spins down and wipes local files): a free external PostgreSQL
# (Neon, Supabase...). When set, all game data lives there and survives restarts. See DEPLOY.md.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Only used when DATABASE_URL is empty (local SQLite file; must be on persistent storage).
# DATABASE_PATH=/absolute/path/to/capybara.db
